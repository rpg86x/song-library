<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="nl.songlibrary.app"
    android:versionCode="18"
    android:versionName="1.8">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <!-- Alleen voor de koffielink -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Instrument-apps die een liedje kunnen openen (nodig om ze te mogen starten) -->
    <queries>
        <package android:name="nl.handpan.app" />
        <package android:name="nl.yogainstruments.app" />
        <package android:name="nl.touchpiano.app" />
        <package android:name="nl.ukulele.app" />
        <package android:name="nl.sbconcert.app" />
    </queries>

    <application
        android:label="Song Library"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
